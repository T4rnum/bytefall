{
  "name": "bytefall",
  "version": "0.1.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "set NODE_NO_WARNINGS=1&& vite",
    "build": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& tsc && vite build && electron-builder --dir",
    "preview": "vite preview",
    "msdf:generate": "node scripts/generate-msdf.mjs && npx msdf-bmfont-xml -f xml -o public/msdf/press-start-2p -s 42 -r 4 -i public/msdf/charset.txt -m 1024,1024 src/assets/fonts/PressStart2P-Regular.ttf"
  },
  "dependencies": {
    "@pixi/core": "^7.4.3",
    "@pixi/display": "^7.4.3",
    "@pixi/events": "^7.4.3",
    "@pixi/graphics": "^7.4.3",
    "@pixi/math": "^7.4.3",
    "@pixi/sprite": "^7.4.3",
    "@pixi/text-bitmap": "^7.4.3",
    "@pixi/ticker": "^7.4.3",
    "clsx": "^2.1.0",
    "gifshot": "^0.4.5",
    "lucide-react": "^0.300.0",
    "pixi-viewport": "^6.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-resizable-panels": "^4.6.2",
    "three": "^0.160.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "msdf-bmfont-xml": "^2.8.0",
    "opentype.js": "^1.3.4",
    "sass": "^1.69.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vite-plugin-electron": "^0.15.4",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "win": {
      "sign": false,
      "signAndEditExecutable": false
    }
  }
}
